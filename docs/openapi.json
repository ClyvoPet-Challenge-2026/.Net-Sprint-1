          },
          "cnpj": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "$ref": "#/components/schemas/CityResponse"
          }
        },
        "additionalProperties": false
      },
      "ClinicPageResponse": {
