{
  "openapi": "3.0.1",
  "info": {
    "title": "ClyvoCare API",
    "description": "API REST do contexto de operação clínica do projeto ClyvoCare (Challenge FIAP 2026). Gerencia clínicas veterinárias, eventos clínicos e lembretes vinculados aos pets cadastrados pela API Java.",
    "contact": {
      "name": "Equipe ClyvoCare",
      "email": "contato@example.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/agendamentos": {
      "post": {
        "tags": [
          "Appointment"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "get": {
        "tags": [
          "Appointment"
        ],
        "parameters": [
          {
            "name": "petId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponsePagedResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Perfil sem permissão"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/agendamentos/{id}": {
      "get": {
        "tags": [
          "Appointment"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Perfil sem permissão"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/cidades": {
      "get": {
        "tags": [
          "City"
        ],
        "summary": "Lista todas as cidades cadastradas, com o estado aninhado.",
        "responses": {
          "200": {
            "description": "Lista retornada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CityResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cidades/{id}": {
      "get": {
        "tags": [
          "City"
        ],
        "summary": "Busca uma cidade pelo Id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único da cidade.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cidade encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cidade não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/clinicas/exportar": {
      "get": {
        "tags": [
          "Clinic"
        ],
        "summary": "Exports relational clinics with embedded city/state documents for MongoDB import.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClinicExportResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Perfil sem permissão"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/clinicas": {
      "get": {
        "tags": [
          "Clinic"
        ],
        "summary": "Lists the legacy array without parameters, or a filtered page with navigation links.",
        "description": "Sem parâmetros preenchidos, retorna array. Com filtros ou paginação, retorna página com links.",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nome",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cnpj",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cityId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista retornada.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ClinicResponse"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/ClinicPageResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Clinic"
        ],
        "summary": "Cria uma clínica.",
        "requestBody": {
          "description": "Dados da clínica.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Clínica criada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicResponse"
                }
              }
            }
          },
          "400": {
            "description": "CNPJ duplicado ou modelo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Cidade informada não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Perfil sem permissão"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/clinicas/{id}": {
      "get": {
        "tags": [
          "Clinic"
        ],
        "summary": "Obtém uma clínica pelo Id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Clínica encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicResponse"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Clinic"
        ],
        "summary": "Atualiza os dados de uma clínica.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador da clínica.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "Novos dados.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Atualizada."
          },
          "400": {
            "description": "CNPJ pertence a outra clínica ou modelo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Clínica ou cidade não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Perfil sem permissão"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Clinic"
        ],
        "summary": "Remove uma clínica pelo Id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removida."
          },
          "404": {
            "description": "Não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Perfil sem permissão"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/clinicas/por-cidade/{cityId}": {
      "get": {
        "tags": [
          "Clinic"
        ],
        "summary": "Lista as clínicas de uma cidade.",
        "parameters": [
          {
            "name": "cityId",
            "in": "path",
            "description": "Identificador da cidade.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista retornada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClinicResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cidade não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/clinicas/buscar": {
      "get": {
        "tags": [
          "Clinic"
        ],
        "summary": "Busca clínicas por nome (parcial) e/ou CNPJ (exato).",
        "parameters": [
          {
            "name": "nome",
            "in": "query",
            "description": "Trecho do nome. Opcional.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cnpj",
            "in": "query",
            "description": "CNPJ exato. Opcional.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados da busca.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClinicResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/estados": {
      "get": {
        "tags": [
          "State"
        ],
        "summary": "Lista todos os estados cadastrados.",
        "responses": {
          "200": {
            "description": "Lista retornada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StateResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/estados/{id}": {
      "get": {
        "tags": [
          "State"
        ],
        "summary": "Busca um estado pelo Id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único do estado.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
